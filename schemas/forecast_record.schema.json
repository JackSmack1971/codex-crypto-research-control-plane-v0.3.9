{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrozenForecast",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forecast_id",
    "run_id",
    "created_at",
    "research_cutoff",
    "research_cutoff_semantics",
    "target_horizon",
    "universe",
    "predictions",
    "source_artifacts"
  ],
  "properties": {
    "forecast_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "research_cutoff": {
      "type": "string"
    },
    "target_horizon": {
      "type": "string"
    },
    "universe": {
      "type": "string"
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset",
          "score"
        ],
        "properties": {
          "asset": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "research_cutoff_semantics": {
      "const": "EXCLUSIVE_UTC_BOUNDARY"
    }
  }
}
