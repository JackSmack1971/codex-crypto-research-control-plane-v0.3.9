{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "attempt_id",
    "created_at",
    "research_cutoff",
    "research_cutoff_semantics",
    "capabilities"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "discovery_status",
          "basic_snapshot_status",
          "access_status",
          "evidence"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "discovery_status": {
            "enum": [
              "VERIFIED",
              "UNKNOWN"
            ]
          },
          "basic_snapshot_status": {
            "enum": [
              "INCLUDED",
              "UNKNOWN"
            ]
          },
          "access_status": {
            "enum": [
              "SUCCEEDED",
              "NOT_ENTITLED",
              "UNAVAILABLE",
              "ERROR",
              "NOT_PROBED"
            ]
          },
          "endpoint_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "probe_params": {
            "type": "object"
          },
          "probed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "research_cutoff_semantics": {
      "const": "EXCLUSIVE_UTC_BOUNDARY"
    }
  }
}
