{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MethodologyAudit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_type",
    "subject_id",
    "auditor",
    "status",
    "reason_codes",
    "evidence"
  ],
  "properties": {
    "subject_type": {
      "enum": ["candidate", "daily_run"]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "auditor": {
      "type": "string",
      "const": "methodology-auditor"
    },
    "status": {
      "enum": ["PASS", "FAIL", "INCONCLUSIVE"]
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"subject_type": {"const": "candidate"}}},
      "then": {"required": ["candidate_id", "hypothesis_id"]}
    },
    {
      "if": {"properties": {"subject_type": {"const": "daily_run"}}},
      "then": {"required": ["run_id"]}
    }
  ]
}
