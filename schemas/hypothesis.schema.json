{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchHypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesis_id",
    "created_at",
    "question",
    "economic_rationale",
    "signal_definition",
    "universe",
    "primary_metric",
    "expected_sign",
    "test_period",
    "multiple_testing_family",
    "status"
  ],
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "economic_rationale": {
      "type": "string",
      "minLength": 1
    },
    "signal_definition": {
      "type": "string",
      "minLength": 1
    },
    "universe": {
      "type": "string",
      "minLength": 1
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "expected_sign": {
      "enum": [
        "positive",
        "negative",
        "two-sided",
        "non-directional"
      ]
    },
    "test_period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "multiple_testing_family": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "REGISTERED"
    },
    "notes": {
      "type": "string"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
