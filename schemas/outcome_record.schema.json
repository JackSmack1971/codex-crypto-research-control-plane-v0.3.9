{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForecastOutcomeRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome_id",
    "forecast_id",
    "forecast_content_digest",
    "scored_at",
    "realized_through",
    "metric_name",
    "metric_value",
    "n_observations",
    "source_artifacts"
  ],
  "properties": {
    "outcome_id": {"type": "string", "minLength": 1},
    "forecast_id": {"type": "string", "minLength": 1},
    "forecast_content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scored_at": {"type": "string", "minLength": 1},
    "realized_through": {"type": "string", "minLength": 1},
    "metric_name": {"type": "string", "minLength": 1},
    "metric_value": {"type": "number"},
    "n_observations": {"type": "integer", "minimum": 1},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
