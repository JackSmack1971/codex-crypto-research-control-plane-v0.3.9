{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromotionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "hypothesis_id",
    "decision",
    "promoted_at",
    "evidence",
    "content_digest"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "decision": {"const": "PROMOTED"},
    "promoted_at": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
