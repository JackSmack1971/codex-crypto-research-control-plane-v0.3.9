{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acquisition_id",
    "run_id",
    "attempt_id",
    "created_at",
    "research_cutoff",
    "source",
    "server_url",
    "status",
    "datasets",
    "errors",
    "limitations",
    "content_digest"
  ],
  "properties": {
    "acquisition_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "massive_mcp"
    },
    "server_url": {
      "const": "https://mcp.massive.com/"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "DEGRADED",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "workspace_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "probe_report_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability_evaluation_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "capability_id",
          "requirement",
          "market",
          "purpose",
          "method",
          "endpoint_path",
          "params",
          "retrieved_at",
          "retrieval_time_source",
          "as_of",
          "discovery_status",
          "basic_snapshot_status",
          "access_status",
          "pagination_complete",
          "row_count",
          "materialization_status",
          "status"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "enum": [
              "CORE",
              "ENRICHMENT",
              "EVENT_OPTIONAL"
            ]
          },
          "market": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "const": "GET"
          },
          "endpoint_path": {
            "type": "string",
            "pattern": "^/"
          },
          "params": {
            "type": "object"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "retrieval_time_source": {
            "enum": [
              "MCP_SERVER",
              "CLIENT_CAPTURED",
              "APPROXIMATE"
            ]
          },
          "as_of": {
            "type": "string",
            "minLength": 1
          },
          "discovery_status": {
            "enum": [
              "VERIFIED",
              "UNKNOWN"
            ]
          },
          "basic_snapshot_status": {
            "enum": [
              "INCLUDED",
              "UNKNOWN"
            ]
          },
          "access_status": {
            "enum": [
              "SUCCEEDED",
              "NOT_ENTITLED",
              "UNAVAILABLE",
              "ERROR"
            ]
          },
          "pagination_complete": {
            "type": "boolean"
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "workspace_table": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "materialization_status": {
            "enum": [
              "VERIFIED",
              "MISSING",
              "FAILED",
              "NOT_REQUIRED"
            ]
          },
          "materialized_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "materialized_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "materialized_row_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "status": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "ACCESS_DENIED",
              "ERROR",
              "UNAVAILABLE",
              "SKIPPED"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "research_cutoff_semantics": {
      "const": "EXCLUSIVE_UTC_BOUNDARY"
    }
  }
}
