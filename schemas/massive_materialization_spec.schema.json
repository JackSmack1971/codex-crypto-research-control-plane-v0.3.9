{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Massive MCP durable materialization specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunks",
    "dataset_id",
    "capability_id",
    "evidence_role",
    "run_id",
    "attempt_id",
    "market",
    "endpoint_path",
    "params",
    "requirement",
    "research_cutoff",
    "research_cutoff_semantics",
    "retrieved_at",
    "as_of",
    "expected_rows",
    "sort_fields",
    "key_fields"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_path": {
      "type": "string",
      "pattern": "^/"
    },
    "params": {
      "type": "object"
    },
    "requirement": {
      "enum": [
        "CORE",
        "ENRICHMENT",
        "EVENT_OPTIONAL"
      ]
    },
    "research_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "expected_rows": {
      "type": "integer",
      "minimum": 0
    },
    "sort_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "key_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_dir": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_role": {
      "enum": [
        "RESEARCH_INPUT",
        "DIAGNOSTIC"
      ]
    },
    "research_cutoff_semantics": {
      "const": "EXCLUSIVE_UTC_BOUNDARY"
    }
  }
}
